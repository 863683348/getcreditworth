{
    "name": "getcreditworth",
    "version": "0.1.0",
    "private": true,
    "description": "Audible credit value optimizer - find the best audiobooks to spend your credits on",
    "scripts": {
        "dev": "next dev",
        "build": "node scripts/generate-books-data.mjs && next build",
        "start": "next start",
        "lint": "next lint",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "fetch-books": "tsx scripts/fetch-books.ts",
        "update-prices": "tsx scripts/update-books-paapi.ts",
        "update-all": "tsx scripts/update-books-paapi.ts"
    },
    "dependencies": {
        "@mdx-js/loader": "3.0.1",
        "@mdx-js/react": "3.0.1",
        "@next/mdx": "14.2.5",
        "@types/mdx": "2.0.13",
        "alipay-sdk": "^4.14.0",
        "lucide-react": "0.408.0",
        "next": "14.2.5",
        "react": "18.3.1",
        "react-dom": "18.3.1"
    },
    "devDependencies": {
        "@types/node": "20.14.10",
        "@types/react": "18.3.3",
        "@types/react-dom": "18.3.0",
        "@vitejs/plugin-react": "4.3.1",
        "autoprefixer": "10.4.19",
        "eslint": "8.57.0",
        "eslint-config-next": "14.2.5",
        "postcss": "8.4.39",
        "tailwindcss": "3.4.6",
        "tsx": "4.16.2",
        "typescript": "5.5.3",
        "vitest": "2.0.3"
    }
}
