# GetCreditWorth 环境变量配置
# 复制此文件为 .env.local 并填写真实值

# Amazon Affiliate Tag (必填)
# 格式: yourtag-20
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=amzreviewer20-20

# 区域专属 Affiliate Tag（可选）
# 区域切换器会把链接路由到对应 Amazon 商店 (amazon.co.uk / amazon.de ...)。
# 若已注册某国 Amazon Associates，填对应 tag；未填则回退上面的全局 US tag。
# 支持两种配置方式（任选其一）：
#   1) 环境变量（推荐，生产不改代码）：
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG_UK=amzreviewer20-21
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG_DE=
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG_FR=amzreviewer0f-21
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG_IT=amzreviewer04-21
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG_ES=
#   2) 或在 lib/utils/affiliate.ts 的 REGION_TAGS 中硬编码（见文件注释）

# PA-API 密钥 (数据拉取脚本用，非前端)
# 申请: https://affiliate-program.amazon.com/assoc_credentials/home
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=amzreviewer20-20
AMAZON_PAAPI_HOST=webservices.amazon.com
AMAZON_PAAPI_REGION=us-east-1

# ISR 按需再生密钥 (Cron 调用 /api/revalidate 时用)
REVALIDATE_SECRET=生成一个随机字符串

# Google Analytics 4 (GA4) - 网站访问统计
# 格式: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-3JBN9YBJN8

# Google AdSense - 广告变现
# 格式: ca-pub-XXXXXXXXXXXX (与 ads.txt 中的 pub-XXXX 同一账号，前缀 ca-)
# 留空则使用代码内置默认值 ca-pub-9043592188127461
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-9043592188127461

# AdSense 手动广告位 Slot ID（纯数字）
# 在 AdSense 后台「广告 → 按广告单元」创建展示广告后获得
# 未配置时对应广告位自动不渲染
NEXT_PUBLIC_ADSENSE_SLOT_BOOKS_LIST=

# 书籍详情页（/books/[asin]）底部广告位 Slot ID，同上规则
# 可与列表页共用同一 slot，也可单独建广告单元以便分别统计
NEXT_PUBLIC_ADSENSE_SLOT_BOOK_DETAIL=

# 博客文章页（/blog/[slug]）底部广告位 Slot ID，同上规则
NEXT_PUBLIC_ADSENSE_SLOT_BLOG_POST=
